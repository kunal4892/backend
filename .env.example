# =============================================================================
# AI Chat App Backend - Environment Configuration
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase Configuration (Required)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# -----------------------------------------------------------------------------
# JWT Configuration (Required)
# -----------------------------------------------------------------------------
JWT_SECRET=your-jwt-secret-min-32-characters

# -----------------------------------------------------------------------------
# Gemini API Configuration (Required)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# Langfuse Tracing Configuration (Optional)
# -----------------------------------------------------------------------------
# Langfuse is an open-source LLM observability platform
# Set these to enable tracing - if not set, tracing is gracefully disabled

# Your Langfuse public key (from Langfuse dashboard)
LANGFUSE_PUBLIC_KEY=pk-lf-xxxxxxxxxxxxxxxx

# Your Langfuse secret key (from Langfuse dashboard)
LANGFUSE_SECRET_KEY=sk-lf-xxxxxxxxxxxxxxxx

# Langfuse host URL (default: http://localhost:3000 for self-hosted)
# For Langfuse Cloud, use: https://cloud.langfuse.com
LANGFUSE_HOST=http://localhost:3000

# -----------------------------------------------------------------------------
# Logging Configuration (Optional)
# -----------------------------------------------------------------------------
# Log level: DEBUG, INFO, WARN, ERROR (default: INFO)
LOG_LEVEL=INFO

# Log format: json or pretty (default: pretty)
LOG_FORMAT=pretty

# -----------------------------------------------------------------------------
# Rate Limiting Configuration (Optional)
# -----------------------------------------------------------------------------
# Requests per minute for chat endpoint (default: 30)
CHAT_RATE_LIMIT=30

# Requests per minute for standard endpoints (default: 60)
STANDARD_RATE_LIMIT=60

# -----------------------------------------------------------------------------
# Notification Configuration (Optional)
# -----------------------------------------------------------------------------
# FCM Server Key for push notifications
FCM_SERVER_KEY=your-fcm-server-key

# -----------------------------------------------------------------------------
# Feature Flags (Optional)
# -----------------------------------------------------------------------------
# Enable/disable features
ENABLE_NOTIFICATIONS=true
ENABLE_RATE_LIMITING=true
ENABLE_LANGFUSE_TRACING=false
